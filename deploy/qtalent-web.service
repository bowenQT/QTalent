[Unit]
Description=QTalent web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qtalent
WorkingDirectory=/opt/qtalent/current
EnvironmentFile=/etc/qtalent/common.env
EnvironmentFile=/etc/qtalent/web.env
ExecStart=/usr/bin/env pnpm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/qtalent/current/.next/cache

[Install]
WantedBy=multi-user.target
