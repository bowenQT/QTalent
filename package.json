{
  "name": "qtalent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:web": "next dev --hostname 127.0.0.1",
    "dev:worker": "node --watch --import tsx src/worker/index.ts",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "start:worker": "node --import tsx src/worker/index.ts",
    "lint": "eslint --no-warn-ignored src tests scripts *.ts *.mjs && pnpm check:boundaries",
    "check:boundaries": "node --import tsx scripts/check-boundaries.ts",
    "format:check": "prettier --check src tests scripts deploy *.json *.ts *.mjs .github/workflows/foundation.yml",
    "format": "prettier --write src tests scripts deploy *.json *.ts *.mjs .github/workflows/foundation.yml",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx src/server/db/migrate.ts",
    "db:seed": "node --import tsx src/server/db/import.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "reference:prepare": "node --import tsx scripts/prepare-reference.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@xmldom/xmldom": "0.9.12",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "jose": "6.2.13",
    "motion": "14.6.0",
    "next": "16.4.3",
    "officeparser": "8.4.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
